# Copie este arquivo para ".env" e preencha com seus valores reais (uso local).
# O .env NUNCA deve ser commitado (já está no .gitignore).
#
# Em produção, NÃO use arquivo .env: defina estas mesmas variáveis no ambiente
# do host (systemd, Docker, painel do PaaS...). Veja o README.md, seção
# "Deploy em produção".

# Chave da API da Groq (obrigatória para o chat funcionar de verdade)
GROQ_API_KEY=gsk_COLOQUE_SUA_CHAVE_AQUI

# Modelo padrão da Groq
GROQ_MODEL=openai/gpt-oss-120b

# Timeout das chamadas à IA (segundos).
# Mantenha ABAIXO de qualquer teto de execução do seu host ou do proxy à
# frente, para a requisição nunca ser cortada antes de a IA responder.
GROQ_TIMEOUT=30

# Porta do servidor
PORT=5000

# Ambiente: "development" (padrão) ou "production".
# Em "production" o debugger é forçado a OFF e ligam-se avisos de segurança.
APP_ENV=development

# Debug do Flask (mantenha false; em produção é ignorado por segurança)
FLASK_DEBUG=false

# Origens permitidas para CORS (separadas por vírgula)
# Em produção troque para o seu domínio real (ex.: https://seu-dominio.com).
# Como o próprio Flask serve o frontend, tudo roda no mesmo domínio
# (same-origin) e o CORS só importa se você chamar a API de outra origem
# (ex.: app mobile, outro site).
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Redirecionar HTTP -> HTTPS (ligue em produção atrás de proxy TLS).
# Deixe false em desenvolvimento local (o dev roda em HTTP).
# Exige TRUSTED_PROXY_COUNT >= 1: o redirect depende do X-Forwarded-Proto,
# que só é lido quando existe proxy confiável configurado abaixo.
FORCE_HTTPS=false

# Número de proxies confiáveis na frente do app (decide se o X-Forwarded-For
# é respeitado para identificar o IP do cliente).
#   0 = SEM proxy (padrão seguro): o header é ignorado e vale o IP do socket.
#       Se o app ficasse atrás de proxy com 0, todos os clientes contariam como
#       um IP só; se NÃO houver proxy e você puser 1, qualquer um forja o
#       próprio IP e burla o rate limit. Use sempre o número real.
#   1 = atrás de exatamente um proxy TLS (nginx, Cloudflare, load balancer).
# Atrás de proxy, defina 1 (necessário também para o FORCE_HTTPS funcionar,
# pois ele depende do X-Forwarded-Proto).
TRUSTED_PROXY_COUNT=0

# Interruptor de emergência. CHAT_ENABLED=false faz o /chat responder 503 e
# mantém o resto do site no ar. É a forma mais rápida de estancar consumo da
# API paga sem redeploy de código — trocar aqui e republicar leva ~30s.
CHAT_ENABLED=true

# Retries do SDK da Groq por requisição. O padrão do PRÓPRIO SDK é 2, o que
# transforma 1 requisição em até 3 chamadas faturadas quando a Groq devolve
# 429/5xx. Mantenha 1 salvo se você souber o que está fazendo.
GROQ_MAX_RETRIES=1

# Teto de requisições do APP INTEIRO ao /chat, somando todos os visitantes.
# O limite por IP não protege sua cota da Groq: quem tem vários IPs (VPN,
# proxy rotativo) simplesmente contorna. Este teto é a barreira que independe
# do IP — é o que impede alguém de queimar seus créditos.
# Formato do flask-limiter: "300 per hour", "50 per minute", etc.
RATE_LIMIT_GLOBAL=300 per hour

# Quantas chamadas a IA podem acontecer AO MESMO TEMPO neste processo.
# O rate limit conta por janela de tempo; ele nao impede 20 chamadas saírem no
# mesmo instante e prenderem 20 workers por ate GROQ_TIMEOUT segundos. O excesso
# e RECUSADO (429), nunca enfileirado.
# O semaforo e por processo: protege o self-host; em serverless limita cada
# instancia, e o teto agregado continua sendo o RATE_LIMIT_GLOBAL.
MAX_CONCURRENT_REQUESTS=4

# Backend do rate limit. memory:// serve para 1 processo (dev).
# Com múltiplos workers (ex.: gunicorn -w 4) ou múltiplas instâncias, memory://
# NÃO é confiável: cada processo tem a própria contagem, então o limite real
# acaba maior que o configurado. Use um backend compartilhado, ex. Redis:
# RATELIMIT_STORAGE_URI=redis://default:senha@host:porta
RATELIMIT_STORAGE_URI=memory://

# Modelos permitidos no /chat (separados por vírgula). O padrão já cobre os
# principais da Groq; descomente para restringir/estender.
# Confira em console.groq.com/docs/deprecations antes de adicionar: um modelo
# desligado passa nesta allowlist e só falha na chamada à Groq.
# ALLOWED_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# (Opcional) Pasta do frontend servido pelo Flask.
# Por padrão aponta para ../landing-page (irmã de servidor/ na raiz do repo).
# Só precisa definir se você mover a pasta ou empacotar de forma diferente.
# FRONTEND_DIR=
